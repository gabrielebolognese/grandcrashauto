import * as THREE from 'three';
import { CONFIG } from '../config';
import type { SurfaceMaterial } from '../core/Physics';
import { GLOBAL_UNIFORMS } from '../core/uniforms';
import type { GameContext, ITerrain } from '../game/contracts';
import type { Pose } from '../world/types';
import { ColliderChunks } from './Colliders';
import { Features } from './Features';
import { BIOME, BIOME_NAMES, shadeAt, SURF_NAMES } from './gen/biome';
import { CorridorSet } from './gen/carve';
import type { ChunkData } from './gen/chunk';
import { cityBeach, coastDistance, lakeLevelAt, newInfo, oceanDistanceAbs, rectDist, sampleTerrain, SEA_WALL_Z, SHORE_Z } from './gen/height';
import type { RingMesh } from './gen/ring';
import type { ScatterData } from './gen/scatterTypes';
import type { TileMesh } from './gen/tile';
import { createFoliageMaterial, createRotorMaterial, createSolidMaterial, createTerrainMaterial, createWaterMaterial, updateTerrainUniforms } from './material';
import { MountainRing } from './MountainRing';
import { ScatterRenderer } from './Scatter';
import { TileManager } from './TileManager';
import { WorkerPool, type JobType } from './WorkerPool';

/**
 * Endless procedural terrain beyond the city + airport (SPEC-PART3 §2–§3, §10).
 *  - Generation: pure functions in ./gen (ABSOLUTE coords, seeded), run in a 2–4 worker pool (./worker.ts).
 *  - Render: quadtree LOD tiles in one BatchedMesh (TileManager), distant mountain ring, instanced scatter.
 *  - Physics: 128 m heightfield colliders near the focus (ColliderChunks), exact same triangles as the L0 tiles.
 *  - Coast features: lighthouse, fishing pier, sea wall, summit viewpoint, lakes (Features).
 * All public queries take LOCAL coordinates (absolute = local + ctx.origin.offset).
 */
export class Terrain implements ITerrain {
  readonly name = 'terrain';
  private pool!: WorkerPool;
  private tiles!: TileManager;
  private colliders!: ColliderChunks;
  private scatter!: ScatterRenderer;
  private ring!: MountainRing;
  private features!: Features;
  private mats: THREE.Material[] = [];
  private ready = false;
  private focus = new THREE.Vector3();
  private hasFocus = false;
  private viewDist = 2200;
  private frame = 0;
  private groundUnderCam = 0;
  private info = newInfo();
  private corrCache = new Map<number, CorridorSet>();
  private camAbs = new THREE.Vector3();
  private uploadMs = 0;
  private uploadMsMax = 0;

  constructor(private ctx: GameContext) {}

  get pois(): { id: string; name: string; icon: string; pose: Pose }[] {
    return this.features?.pois ?? [];
  }

  init(): void {
    const { ctx } = this;
    const terrainMat = createTerrainMaterial(ctx);
    const foliage = createFoliageMaterial(ctx);
    const rock = createSolidMaterial(ctx, 'terrain.rock', 'ground', 0.92);
    const solid = createSolidMaterial(ctx, 'terrain.solid', 'building', 0.8);
    const rotor = createRotorMaterial();
    const water = createWaterMaterial();
    this.mats.push(terrainMat, foliage, rock, solid, rotor, water);

    this.pool = new WorkerPool((type, key, data, ms) => this.onResult(type, key, data, ms));
    this.pool.start(CONFIG.game.seed);
    this.tiles = new TileManager(terrainMat, this.pool);
    this.tiles.onLakes = (lakes) => this.features.addLakes(lakes, ctx.origin.offset.x, ctx.origin.offset.z);
    this.colliders = new ColliderChunks(ctx.physics, this.pool);
    this.scatter = new ScatterRenderer(ctx, this.pool, { foliage, rock, solid, rotor });
    this.ring = new MountainRing(terrainMat, this.pool);
    this.features = new Features(ctx.physics, solid, water);
    this.features.build(ctx.origin.offset.x, ctx.origin.offset.z);

    const scene = ctx.engine.scene;
    scene.add(this.tiles.mesh, this.ring.mesh, this.scatter.group, this.features.group);

    ctx.events.on('originShift', ({ delta }) => {
      this.tiles.onOriginShift(delta.x, delta.z);
      this.scatter.onOriginShift(delta.x, delta.z);
      this.features.onOriginShift(delta.x, delta.z);
      this.focus.x -= delta.x;
      this.focus.z -= delta.z;
    });
    ctx.events.on('qualityChanged', () => this.scatter.applyQuality());
    this.ready = true;
    if (ctx.debug) (window as unknown as { __terrain?: Terrain }).__terrain = this;
  }

  /** Before the title screen: the tiles around the spawn are generated + uploaded (short, capped). */
  async warmup(): Promise<void> {
    if (!this.ready) return;
    const sp = this.ctx.world?.data?.spawn?.position;
    const cam = this.ctx.engine.camera;
    if (sp && !this.hasFocus) {
      this.focus.set(sp.x, sp.y, sp.z);
      this.hasFocus = true;
    }
    const t0 = performance.now();
    const cap = 3500;
    while (performance.now() - t0 < cap) {
      this.step(0, cam, 1e9);
      const s = this.tiles.stats;
      if (this.frame > 4 && s.holes === 0 && this.pool.pending === 0) break;
      await new Promise((r) => setTimeout(r, 16));
    }
    console.info(`[terrain] warmup ${Math.round(performance.now() - t0)} ms, tiles ${this.tiles.stats.drawn}, holes ${this.tiles.stats.holes}`);
  }

  setFocus(pos: THREE.Vector3): void {
    this.focus.copy(pos);
    this.hasFocus = true;
  }

  update(dt: number): void {
    if (!this.ready) return;
    const t0 = performance.now();
    this.step(dt, this.ctx.engine.camera, CONFIG.terrain.uploadBudgetMs);
    const ms = performance.now() - t0;
    this.uploadMs = this.uploadMs * 0.95 + ms * 0.05;
    if (this.frame > 60) this.uploadMsMax = Math.max(this.uploadMsMax * 0.999, ms);
  }

  private step(dt: number, cam: THREE.PerspectiveCamera, budgetMs: number): void {
    this.frame++;
    const off = this.ctx.origin.offset;
    const T = CONFIG.terrain;
    const q = this.ctx.quality.current as typeof this.ctx.quality.current & { terrainViewDistance?: number };
    const camX = cam.position.x + off.x;
    const camZ = cam.position.z + off.z;
    const camY = cam.position.y;
    this.camAbs.set(camX, camY, camZ);
    if (this.frame % 4 === 1) {
      const g = this.colliders.heightAt(camX, camZ);
      this.groundUnderCam = g === g ? g : sampleTerrain(camX, camZ, this.info);
    }
    const alt = Math.max(0, camY - this.groundUnderCam - 60);
    this.viewDist = Math.min(T.maxViewDistance, (q.terrainViewDistance ?? 2200) * (1 + (T.altitudeView * alt) / 1000));
    const lvl = this.ctx.quality.level;
    const lod0 = lvl === 'low' ? T.lodRadius.low : lvl === 'high' ? T.lodRadius.high : T.lodRadius.medium;

    this.pool.pump(budgetMs);
    const deadline = performance.now() + budgetMs;
    if (this.frame % Math.max(1, T.selectEvery) === 1 || T.selectEvery <= 1) {
      this.tiles.select(camX, camY, camZ, this.groundUnderCam, this.viewDist, lod0);
    }
    this.tiles.upload(deadline, off.x, off.z);
    this.tiles.updateVisibility(cam, off.x, off.z);
    this.tiles.prune();

    const fx = (this.hasFocus ? this.focus.x : cam.position.x) + off.x;
    const fz = (this.hasFocus ? this.focus.z : cam.position.z) + off.z;
    this.colliders.update(fx, fz, off.x, off.z, deadline);
    this.scatter.update(camX, camY, camZ, this.groundUnderCam, off.x, off.z, deadline);
    this.ring.update(camX, camZ, this.viewDist);
    this.features.update(dt, camX, camZ);
    updateTerrainUniforms(cam, this.viewDist);
  }

  private onResult(type: JobType, key: string, data: unknown, _ms: number): void {
    const off = this.ctx.origin.offset;
    if (type === 'tile') this.tiles.onTile(key, data as TileMesh);
    else if (type === 'chunk') this.colliders.onChunk(data as ChunkData);
    else if (type === 'scatter') this.scatter.onScatter(data as ScatterData);
    else if (type === 'ring') this.ring.onRing(key, data as RingMesh, off.x, off.z);
  }

  // ─────────────────────────────── queries (LOCAL coordinates) ───────────────────────────────

  private inFlat(ax: number, az: number): boolean {
    const W = CONFIG.world;
    return rectDist(ax, az, W.cityBounds) < 0 || rectDist(ax, az, W.airportBounds) < 0;
  }

  private flatLevel(ax: number, az: number): number {
    return az > SEA_WALL_Z + 0.4 ? cityBeach(ax, az) : 0;
  }

  /** Corridor set for the 256 m cell around a point (main-thread fallback path). */
  private corridorsAt(ax: number, az: number): CorridorSet {
    const cs = 256;
    const i = Math.floor(ax / cs);
    const j = Math.floor(az / cs);
    const k = (i + 40000) * 80000 + (j + 40000);
    let c = this.corrCache.get(k);
    if (!c) {
      c = CorridorSet.forRect(i * cs, j * cs, (i + 1) * cs, (j + 1) * cs);
      if (this.corrCache.size > 64) this.corrCache.delete(this.corrCache.keys().next().value!);
      this.corrCache.set(k, c);
    }
    return c;
  }

  private heightAbs(ax: number, az: number): number {
    if (this.inFlat(ax, az)) return this.flatLevel(ax, az);
    const h = this.ready ? this.colliders.heightAt(ax, az) : NaN;
    if (h === h) return h;
    let n = sampleTerrain(ax, az, this.info);
    if (this.info.flat >= 0) {
      const c = this.corridorsAt(ax, az);
      if (!c.empty) n = c.carve(n, ax, az);
    }
    return n;
  }

  heightAt(x: number, z: number): number {
    const off = this.ctx.origin.offset;
    return this.heightAbs(x + off.x, z + off.z);
  }

  private snowLine(): number {
    return GLOBAL_UNIFORMS.uSnowLine.value - GLOBAL_UNIFORMS.uSnow.value * 420;
  }

  private codesAbs(ax: number, az: number): { surf: number; biome: number; flat: number; h: number } {
    const c = this.ready ? this.colliders.sampleCodes(ax, az) : null;
    const h = this.heightAbs(ax, az);
    if (c) return { surf: c.surf, biome: c.biome, flat: c.flat / 255, h };
    // fallback: evaluate the colour/biome function with a local slope estimate
    const hx = this.heightAbs(ax + 2, az);
    const hz = this.heightAbs(ax, az + 2);
    const gx = (hx - h) / 2;
    const gz = (hz - h) / 2;
    const ny = 1 / Math.sqrt(1 + gx * gx + gz * gz);
    sampleTerrain(ax, az, this.info);
    this.info.h = h;
    const s = shadeAt(ax, az, this.info, ny, 0, 2, 0.5);
    return { surf: s.surf, biome: s.biome, flat: ny, h };
  }

  surfaceAt(x: number, z: number): SurfaceMaterial {
    const off = this.ctx.origin.offset;
    const ax = x + off.x;
    const az = z + off.z;
    if (this.inFlat(ax, az)) return az > SEA_WALL_Z + 0.4 ? 'sand' : 'asphalt';
    const c = this.codesAbs(ax, az);
    if (c.h > this.snowLine() && c.flat > 0.6) return 'snow';
    return SURF_NAMES[c.surf] as SurfaceMaterial;
  }

  biomeAt(x: number, z: number): string {
    const off = this.ctx.origin.offset;
    const ax = x + off.x;
    const az = z + off.z;
    if (rectDist(ax, az, CONFIG.world.cityBounds) < 0) return 'city';
    if (rectDist(ax, az, CONFIG.world.airportBounds) < 0) return 'airport';
    const c = this.codesAbs(ax, az);
    if (c.h > this.snowLine() && c.flat > 0.6 && c.biome !== BIOME.ocean && c.biome !== BIOME.lake) return 'snow';
    return BIOME_NAMES[c.biome] ?? 'meadow';
  }

  waterAt(x: number, z: number): number | null {
    const off = this.ctx.origin.offset;
    const ax = x + off.x;
    const az = z + off.z;
    const wl = CONFIG.world.waterLevel;
    if (this.inFlat(ax, az)) return az > SHORE_Z && this.flatLevel(ax, az) < wl ? wl : null;
    const h = this.heightAbs(ax, az);
    const lake = lakeLevelAt(ax, az);
    if (lake === lake && h < lake) return lake;
    if (h < wl && coastDistance(ax, az) < 120) return wl;
    return null;
  }

  oceanDistance(x: number, z: number): number {
    const off = this.ctx.origin.offset;
    return oceanDistanceAbs(x + off.x, z + off.z);
  }

  isReady(x: number, z: number, radius: number): boolean {
    if (!this.ready) return false;
    const off = this.ctx.origin.offset;
    const ax = x + off.x;
    const az = z + off.z;
    const W = CONFIG.world;
    const r = Math.max(1, radius);
    const inside = (b: { minX: number; maxX: number; minZ: number; maxZ: number }) => ax - r >= b.minX && ax + r <= b.maxX && az - r >= b.minZ && az + r <= b.maxZ;
    if (inside(W.cityBounds) || inside(W.airportBounds)) return true;
    if (this.colliders.isReady(ax, az, r)) return true;
    this.colliders.requestArea(ax, az, r + 64);
    return false;
  }

  /** Debug / smoke numbers. */
  debugStats(): Record<string, unknown> {
    return {
      tiles: { ...this.tiles.stats },
      colliders: { ...this.colliders.stats },
      scatter: { ...this.scatter.stats },
      pool: { workers: this.pool.size, pending: this.pool.pending, ...this.pool.stats },
      viewDist: Math.round(this.viewDist),
      updateMsAvg: +this.uploadMs.toFixed(2),
      updateMsMax: +this.uploadMsMax.toFixed(2),
    };
  }

  dispose(): void {
    this.pool?.dispose();
    this.tiles?.dispose();
    this.colliders?.dispose();
    this.scatter?.dispose();
    this.ring?.dispose();
    this.features?.dispose();
    for (const m of this.mats) m.dispose();
  }
}
